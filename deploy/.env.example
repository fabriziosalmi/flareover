# flareover deploy/: copy to .env and fill in. Never commit .env.

# Where `flareover prepare --out <dir>` wrote the artifacts (Caddyfile, WAF rules).
ARTIFACTS=./out

# --- secrets ----------------------------------------------------------------
# flareover reads these from the ENVIRONMENT, never from the command line, so
# nothing leaks via `ps` or shell history. Load them before running provision:
#
#   set -a; . ./.env; set +a
#
# (`provision --pdns-key` / `--certmate-token` are refused with exit 2.)

# PowerDNS API key.
PDNS_API_KEY=change-me-a-long-random-key

# CertMate API bearer token: MUST be 32–512 chars.
CERTMATE_TOKEN=change-me-to-a-32-to-512-char-random-token-xxxxxxxx

# MinIO root credentials.
MINIO_ROOT_USER=flareover
MINIO_ROOT_PASSWORD=change-me-a-strong-password

# --- image versions ---------------------------------------------------------
# Pinned, not :latest. These services hold the authoritative zone, the DNSSEC
# keys and the migrated objects; an upgrade should be a reviewed change, and a
# rollback should be possible because the previous version is written down.
PDNS_IMAGE=powerdns/pdns-auth-49:4.9.17
# MinIO is distributed on quay.io, not Docker Hub: `minio/minio` no longer
# resolves there, which is why the stack could not pull it at all before this
# was pinned.
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
CERTMATE_IMAGE=ghcr.io/fabriziosalmi/certmate:latest
SPM_IMAGE=ghcr.io/fabriziosalmi/secure-proxy-manager:latest

# --- network ----------------------------------------------------------------
# Which host address publishes authoritative DNS on port 53. The default binds
# every interface, which is what a real edge wants — but on a host running
# systemd-resolved (Ubuntu, Debian, Fedora) that collides with its stub listener
# on 127.0.0.53:53 and the container refuses to start. Either free port 53 (see
# deploy/README.md § Gotchas) or name the public address here.
DNS_BIND=0.0.0.0

# The internal tier's subnet. Declared (rather than left to Docker) so the
# PowerDNS API can restrict itself to it instead of accepting 0.0.0.0/0.
# Change it if it collides with something on your host.
INTERNAL_SUBNET=172.28.0.0/16
